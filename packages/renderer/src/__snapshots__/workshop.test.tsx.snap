// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`machine-tier visuals (spec §5A) > snapshots each tier so an art change is a reviewed diff > machine-tier-1 1`] = `
"<svg class="printhead-workshop" role="img" aria-label="PRINTHEAD workshop — Studio" data-visual-version="10" data-phase="studio" data-slot-capacity="1" data-layout="rack" data-backdrop="workshop" data-self-assembling="true" viewBox="0 0 160 252" preserveAspectRatio="xMidYMid meet"><title>PRINTHEAD — Studio</title><style>
.printhead-workshop {
  --ph-ink: #d7dee6;
  --ph-dim: #7b8794;
  --ph-bay: #10151b;
  --ph-bay-edge: #263141;
  --ph-accent: #4cc2ff;
  --ph-gold: #e8c469;
    --ph-warn: #ffb454;
  --ph-hot: #ff8a3d;
  --ph-sweep: 3.4s;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  display: block;
  width: 100%;
  height: auto;
}

.ph-bay { fill: var(--ph-bay); stroke: var(--ph-bay-edge); stroke-width: 1.5; }
.ph-bay--empty { fill: none; stroke-dasharray: 5 5; opacity: 0.45; }
.ph-bay--floor { fill: transparent; stroke: none !important; }
.ph-floor-shadow { fill: rgba(0, 0, 0, 0.3); }
.ph-floor-spot { cursor: grab; }
.ph-pile-part { fill: var(--char-pla, #E23673); stroke: #1C2330; stroke-width: 1.5; stroke-linejoin: round; }
.ph-pile-box { fill: #E2AA3A; stroke: #1C2330; stroke-width: 1.5; }
.ph-pile-item { transform-box: fill-box; animation: ph-pile-drop 420ms cubic-bezier(0.3, 1.6, 0.5, 1) both; }
@keyframes ph-pile-drop { from { opacity: 0; translate: 0 -24px; } to { opacity: 1; translate: 0 0; } }
.ph-wall { fill: rgba(255, 255, 255, 0.025); }
.ph-wall-skirting { stroke: rgba(255, 255, 255, 0.08); stroke-width: 2; }
.ph-wall-item { animation: ph-wall-in 700ms cubic-bezier(0.3, 1.5, 0.5, 1) both; transform-box: fill-box; transform-origin: top center; }
@keyframes ph-wall-in { from { opacity: 0; transform: translateY(-10px) rotate(-3deg); } }
.ph-wall-board { fill: #c9a26b; stroke: #1C2330; stroke-width: 2; }
.ph-wall-hole { fill: #8a6a3e; }
.ph-wall-tool { fill: none; stroke: #6C7884; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
.ph-wall-window { fill: #2a4d6e; stroke: #1C2330; stroke-width: 3; }
.ph-wall-frame { stroke: #1C2330; stroke-width: 3; }
.ph-wall-shelf { fill: #8a6a3e; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-spool-rim { fill: #DCE0DE; stroke: #1C2330; stroke-width: 2; }
.ph-wall-spool-hub { fill: #FAFAF7; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-clock { fill: #FAFAF7; stroke: #1C2330; stroke-width: 3; }
.ph-wall-hand { stroke: #1C2330; stroke-width: 2.5; stroke-linecap: round; }
.ph-wall-blueprint { fill: #2E5FC2; stroke: #1C2330; stroke-width: 2; }
.ph-wall-blueprint-ink { fill: none; stroke: #cfe0ff; stroke-width: 1.5; stroke-linecap: round; }
.ph-wall-plate { fill: #E2AA3A; stroke: #7a5208; stroke-width: 2; }
.ph-wall-neon { font: 400 30px/1 'Tilt Warp', 'Arial Rounded MT Bold', sans-serif; fill: #ff8ab3; letter-spacing: 4px; filter: drop-shadow(0 0 4px #ff3d84) drop-shadow(0 0 12px #ff3d84); animation: ph-neon 4s steps(1) infinite; }
@keyframes ph-neon { 0%, 92%, 96% { opacity: 1; } 93%, 97% { opacity: 0.35; } }
.ph-wall-wire { fill: none; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-bulb { fill: #ffd75a; filter: drop-shadow(0 0 4px #ffd75a); animation: ph-bulb 1.5s ease-in-out infinite alternate; }
@keyframes ph-bulb { to { opacity: 0.45; } }
.ph-slot--celebrate [data-testid="printer-figure"] &gt; g { transform-box: fill-box; transform-origin: 50% 100%; animation: ph-hop 520ms cubic-bezier(0.3, 1.6, 0.5, 1); }
@keyframes ph-hop { 0% { scale: 1 1; } 25% { scale: 1.08 0.9; } 55% { scale: 0.95 1.08; translate: 0 -6px; } 100% { scale: 1 1; translate: 0 0; } }
.ph-crew-more { font: 700 16px/1 'Martian Mono', ui-monospace, monospace; fill: var(--ph-accent); }
.ph-floor-spot.is-grabbed { cursor: grabbing; }
.ph-floor-spot.is-grabbed .ph-floor-shadow { fill: rgba(0, 0, 0, 0.18); }

.ph-label { fill: var(--ph-ink); font-size: 11px; }
.ph-label--dim { fill: var(--ph-dim); font-style: italic; }
.ph-badge-disc { fill: var(--ph-accent); }
.ph-badge-text { fill: #05090d; font-size: 12px; font-weight: 700; }

.ph-progress-track { fill: var(--ph-bay-edge); }
.ph-progress-fill { fill: var(--ph-accent); }
.ph-progress-fill--purge { fill: var(--ph-dim); }
.ph-risk-track { fill: var(--ph-bay-edge); }
.ph-risk-fill { fill: var(--ph-warn); }
.ph-perfect-fill { fill: var(--ph-gold); }

/* --- overclock (tap a printer) ----------------------------------------- */
.ph-oc-track { fill: none; stroke: var(--ph-bay-edge); stroke-width: 3; }
.ph-oc-fill { fill: none; stroke-width: 3; stroke-linecap: round; transition: stroke-dasharray 0.2s linear; }
.ph-oc-fill--ready { stroke: var(--ph-accent); }
.ph-oc-fill--active { stroke: var(--ph-hot); }
.ph-oc-fill--cooling { stroke: var(--ph-dim); }
.ph-oc-bolt { fill: var(--ph-ink); }
.ph-slot--pressable { cursor: pointer; }
.ph-slot--pressable:hover .ph-bay { stroke: var(--ph-accent); }
.ph-slot:focus-visible { outline: none; }
.ph-slot:focus-visible .ph-bay { stroke: var(--ph-accent); stroke-width: 3; }
[data-overclocked="true"] .ph-bay { stroke: var(--ph-hot); stroke-width: 2.5; }

/* --- print rota (spec §5B) ---------------------------------------------- */
.ph-queue-pip { fill: var(--ph-bay-edge); }
.ph-queue-pip--current { fill: var(--ph-accent); }

/* --- frame tiers (spec §5A) --------------------------------------------- */
.printer--frame-acrylic   { --ph-frame: #9fd9ff; --ph-frame-fill: rgba(159, 217, 255, 0.10); }
.printer--frame-aluminium { --ph-frame: #c9d3dd; --ph-frame-fill: rgba(201, 211, 221, 0.16); }
.printer--frame-steel     { --ph-frame: #8b98a8; --ph-frame-fill: rgba(139, 152, 168, 0.28); }

.ph-frame { fill: var(--ph-frame-fill); stroke: var(--ph-frame); }
.ph-strut { fill: var(--ph-frame); }
.ph-base { fill: #1b232d; stroke: var(--ph-frame); stroke-width: 1; }
.ph-enclosure { fill: rgba(159, 217, 255, 0.06); stroke: var(--ph-frame); stroke-dasharray: 3 3; }

/* --- bed tiers ----------------------------------------------------------- */
.ph-bed { fill: #38424f; }
.printer--bed-tape .ph-bed { fill: #4a5462; }
.printer--bed-heated .ph-bed { fill: #6b3a2c; }
.printer--bed-auto-level .ph-bed { fill: #2f4a44; }
.ph-bed-probe { fill: var(--ph-accent); }
.ph-bed-heat { fill: var(--ph-hot); opacity: 0.35; }

/* --- nozzle tiers -------------------------------------------------------- */
.ph-carriage-body { fill: #2b3542; stroke: var(--ph-frame); stroke-width: 1; }
.ph-nozzle { fill: #b98b3f; }
.printer--nozzle-hardened .ph-nozzle { fill: #6f7883; }
.printer--nozzle-glowing .ph-nozzle { fill: #ffd08a; }
.ph-nozzle-glow { fill: var(--ph-hot); opacity: 0; }
.printer--nozzle-glowing .ph-nozzle-glow { opacity: 0.3; }
.printer--running .ph-nozzle-glow { opacity: 0.55; }

.ph-spool-rim { fill: none; stroke: var(--ph-accent); stroke-width: 3; }
.ph-spool-hub { fill: var(--ph-dim); }
.ph-filament { fill: none; stroke: var(--ph-accent); stroke-width: 1.2; opacity: 0.7; }
.ph-controller { fill: #1b232d; stroke: var(--ph-frame); stroke-width: 1; }
.ph-controller-screen { fill: var(--ph-accent); opacity: 0.55; }
.ph-print { fill: var(--ph-accent); opacity: 0.85; }
/* A Product is not a Part: the studio bay reads gold (spec §5D). */
.ph-print--product { fill: var(--ph-gold); opacity: 0.95; }

/* The mint (spec §5E): one bill per installed press level, gently breathing. */
.ph-bill {
  fill: var(--ph-gold);
  opacity: 0.8;
  animation: ph-mint 1.8s ease-in-out infinite;
}
@keyframes ph-mint {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.95; }
}
@media (prefers-reduced-motion: reduce) {
  .ph-bill { animation: none; opacity: 0.8; }
}

/* --- the printed city (spec §5E) ----------------------------------------- */
.ph-backdrop-tower { fill: var(--ph-bay-edge); opacity: 0.5; }

/* --- the Universal Fabricator (spec §6 phase 6) --------------------------- */
.ph-fabricator-bed { fill: #1b232d; stroke: var(--ph-dim); stroke-width: 1; }
.ph-fabricator-band { fill: var(--ph-accent); opacity: 0.9; }
.ph-fabricator-band--pending { fill: none; stroke: var(--ph-bay-edge); stroke-width: 1; }
.ph-fabricator-band--printing {
  fill: var(--ph-hot);
  animation: ph-pulse 1.2s ease-in-out infinite;
}
.ph-fabricator--complete .ph-fabricator-band { fill: var(--ph-gold); }

/* --- the ending (spec §6 phase 6) ---------------------------------------- */
.printhead-ending {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  display: block;
  width: 100%;
  height: auto;
  background: #05090d;
}
.ph-ending-title { fill: #e8c469; font-size: 48px; text-anchor: middle; }
.ph-ending-line { fill: #d7dee6; font-size: 11px; text-anchor: middle; }
.ph-museum-case { fill: rgba(159, 217, 255, 0.05); stroke: #7b8794; stroke-dasharray: 4 3; }

/* --- the idle print-head animation --------------------------------------- */
@keyframes ph-sweep {
  from { transform: translateX(0); }
  to   { transform: translateX(var(--ph-travel, 70px)); }
}
@keyframes ph-spin { to { transform: rotate(360deg); } }
@keyframes ph-pulse {
  0%, 100% { opacity: 0.25; }
  50%      { opacity: 0.7; }
}

.ph-carriage {
  animation: ph-sweep var(--ph-sweep) ease-in-out infinite alternate;
  animation-delay: calc(var(--ph-offset, 0) * var(--ph-sweep) * -1);
}
.printer--idle .ph-carriage { animation-duration: calc(var(--ph-sweep) * 2.5); }
.ph-spool {
  transform-box: fill-box;
  transform-origin: center;
  animation: ph-spin calc(var(--ph-sweep) * 3) linear infinite;
  animation-delay: calc(var(--ph-offset, 0) * var(--ph-sweep) * -3);
  animation-play-state: paused;
}
.printer--running .ph-spool { animation-play-state: running; }
.printer--running .ph-nozzle-glow { animation: ph-pulse var(--ph-sweep) ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .ph-carriage, .ph-spool, .ph-nozzle-glow { animation: none; }
}


/* ==== Characters ========================================================= */
.pc-char { display: block; overflow: visible; }
.pc-o { stroke: var(--char-outline, #1C2330); stroke-width: var(--stroke-char, 3px); stroke-linejoin: round; stroke-linecap: round; }
.pc-none { fill: none; }
.pc-ink { fill: var(--char-outline, #1C2330); }
.pc-shell { fill: var(--char-shell, #FAFAF7); }
.pc-shade { fill: var(--char-shade, #DCE0DE); }
.pc-pla { fill: var(--char-pla, #E23673); }
.pc-acrylic { fill: var(--char-acrylic, #BEE5F4); }
.pc-alu { fill: var(--char-alu, #C7CFD5); }
.pc-steel { fill: var(--char-steel, #6C7884); }
.pc-brass { fill: var(--char-brass, #E2AA3A); }
.pc-tape { fill: var(--char-tape, #58A8E6); }
.pc-heat { fill: var(--char-heat, #EF6236); }
.pc-gold { fill: var(--char-brass, #E2AA3A); }
.pc-money { fill: var(--char-money, #4FA86E); }
.pc-carbon { fill: var(--char-carbon, #30353D); }
.pc-carbon-back { fill: var(--char-carbon, #30353D); opacity: 0.45; }
.pc-masking { fill: #efe1b0; }
.pc-petg-c { fill: #1fa595; }
.pc-resin-c { fill: var(--char-amber, #F5A23A); }
.pc-blueprint-c { fill: #4c86e8; }
.pc-plate-in { fill: #2a323b; }
.pc-mat-pla { fill: #E23673; }
.pc-mat-petg { fill: #1FA595; }
.pc-mat-resin { fill: #F5A23A; }
.pc-mat-metal { fill: #9AA6B2; }
.pc-mat-composite { fill: #4C5563; }
.pc-print-product { fill: var(--ph-gold, #e2b65a); }
.pc-resin-print { fill: #f3c98a; }
.pc-screen { fill: var(--char-screen, #142A2C); }
.pc-pixel { fill: var(--char-pixel, #7DF0C3); }
.pc-glare { fill: #ffffff; opacity: 0.08; }
.pc-shadow { fill: var(--char-shadow, rgba(28, 35, 48, 0.14)); }
.pc-amber { fill: var(--char-amber, #F5A23A); fill-opacity: 0.72; }
.pc-glass { fill: var(--char-glass, #D6F1F6); fill-opacity: 0.4; }
.pc-hot { fill: #ffd27a; }
.pc-glow { fill: #ff9a3c; opacity: 0.45; }
.pc-thin { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 2px; stroke-linecap: round; }
.pc-seam { fill: none; stroke: #ffffff; stroke-opacity: 0.55; stroke-width: 1.5px; }
.pc-layer { fill: none; stroke: var(--char-pla-deep, #A8204F); stroke-width: 1.5px; stroke-linecap: round; }
.pc-layer-petg { fill: none; stroke: #0b6a5f; stroke-width: 1.5px; stroke-linecap: round; }
.pc-layer-resin { fill: none; stroke: #c48a3a; stroke-width: 1.2px; }
.pc-winding { stroke: var(--char-pla-deep, #A8204F); stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-winding-petg { stroke: #0b6a5f; stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-winding-gold { stroke: #9a6c14; stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-filament { fill: none; stroke: var(--char-pla, #E23673); stroke-width: 2.5px; stroke-linecap: round; }
.pc-filament-petg { fill: none; stroke: #1fa595; stroke-width: 2.5px; stroke-linecap: round; }
.pc-filament-gold { fill: none; stroke: var(--char-brass, #E2AA3A); stroke-width: 2.5px; stroke-linecap: round; }
.pc-groove { fill: none; stroke: #8f9aa3; stroke-width: 2px; }
.pc-shimmer { fill: none; stroke: var(--char-heat, #EF6236); stroke-width: 2.5px; stroke-linecap: round; opacity: 0.8; }
.pc-speckle { fill: none; stroke: #7d5a14; stroke-width: 2.5px; stroke-linecap: round; opacity: 0.6; }
.pc-reflect { fill: none; stroke: #ffffff; stroke-width: 3px; stroke-linecap: round; opacity: 0.55; }
.pc-liquid { fill: none; stroke: var(--char-amber, #F5A23A); stroke-width: 3px; stroke-linecap: round; }
.pc-rivet { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 4px; stroke-linecap: round; opacity: 0.5; }
.pc-arm { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 2.5px; stroke-linecap: round; }
.pc-halo { fill: none; stroke: var(--char-brass, #E2AA3A); stroke-width: 4px; opacity: 0.9; }

/* idle life: blink, sweep, spool, shimmer. Phase offset desyncs bays. */
.pc-eyes-blink { opacity: 0; }
.pc-char .pc-eyes-open { animation: pc-blink-open 5.2s steps(1) infinite; animation-delay: calc(var(--pc-offset, 0) * -5.2s); }
.pc-char .pc-eyes-blink { animation: pc-blink-shut 5.2s steps(1) infinite; animation-delay: calc(var(--pc-offset, 0) * -5.2s); }
@keyframes pc-blink-open { 0%, 95% { opacity: 1; } 96%, 99% { opacity: 0; } }
@keyframes pc-blink-shut { 0%, 95% { opacity: 0; } 96%, 99% { opacity: 1; } }
.is-printing .pc-carriage { animation: pc-sweep var(--ph-sweep, 3.4s) ease-in-out infinite alternate; animation-delay: calc(var(--pc-offset, 0) * -3.4s); }
@keyframes pc-sweep { from { transform: translateX(-16px); } to { transform: translateX(16px); } }
.is-printing .pc-spool { transform-box: fill-box; transform-origin: center; animation: pc-spin 10s linear infinite; }
@keyframes pc-spin { to { transform: rotate(360deg); } }
.is-printing .pc-shimmer { animation: pc-shimmer 1.6s ease-in-out infinite; }
@keyframes pc-shimmer { 50% { opacity: 0.25; transform: translateY(-3px); } }
.is-printing .pc-bill-fly { animation: pc-float 2.4s ease-in-out infinite; }
@keyframes pc-float { 50% { transform: translateY(-5px); } }
@media (prefers-reduced-motion: reduce) {
  .pc-char *, .pc-char { animation: none !important; }
  .pc-eyes-blink { opacity: 0; }
}


/* overclocked: the toolhead races and the bay glows */
.is-overclocked .pc-carriage { animation-duration: 0.9s; }
.is-overclocked .pc-glare { opacity: 0.2; }

</style><g transform="translate(0, 0)"><g data-testid="slot-slot-1" data-occupied="true" data-slot-index="0" data-output="parts" data-overclocked="true" class="ph-slot  "><rect data-testid="bay-slot-1" class="ph-bay" x="0" y="0" width="160" height="208" rx="8"></rect><g data-testid="printer-figure" data-machine-tier="1" data-frame="acrylic" data-nozzle="brass" data-bed="tape" data-output="parts" class="printer printer--tier-1 printer--frame-acrylic printer--running" style="--ph-offset: 0;"><title>Acrylic frame · brass nozzle · taped bed</title><g transform="translate(-4, 4) scale(0.84)"><g data-testid="character" data-kind="mk1" data-face="worried" class="pc-char pc-mk1 is-printing is-overclocked" style="--pc-offset: 0;"><ellipse class="pc-shadow" cx="100" cy="188" rx="70" ry="6"></ellipse><rect class="pc-o pc-ink" x="42" y="174" width="18" height="9" rx="3" data-part="frame"></rect><rect class="pc-o pc-ink" x="140" y="174" width="18" height="9" rx="3" data-part="frame"></rect><path class="pc-o pc-none" d="M154 46h22" data-part="spool-holder"></path><circle class="pc-o pc-pla" cx="176" cy="66" r="19" data-part="spool-holder"></circle><circle class="pc-winding" cx="176" cy="66" r="14" fill="none" data-part="spool-holder"></circle><circle class="pc-o pc-shell" cx="176" cy="66" r="7.22" data-part="spool-holder"></circle><circle class="pc-ink" cx="176" cy="66" r="2.28" data-part="spool-holder"></circle><rect class="pc-o pc-acrylic" x="40" y="42" width="12" height="110" rx="3" data-part="frame"></rect><rect class="pc-o pc-acrylic" x="148" y="42" width="12" height="110" rx="3" data-part="frame"></rect><rect class="pc-o pc-acrylic" x="36" y="38" width="128" height="12" rx="4" data-part="frame"></rect><rect class="pc-o pc-shell" x="30" y="148" width="140" height="30" rx="9" data-part="frame"></rect><path class="pc-thin" d="M44 158h14M44 164h14M44 170h14" data-part="frame"></path><circle class="pc-o pc-pla" cx="152" cy="163" r="7" data-part="frame"></circle><circle class="pc-ink" cx="152" cy="163" r="2" data-part="frame"></circle><rect class="pc-o pc-masking" x="35" y="104" width="22" height="8" rx="2" transform="rotate(-14 46 108)" data-part="frame"></rect><rect class="pc-o pc-tape" x="50" y="136" width="100" height="12" rx="3" data-part="bed"></rect><path class="pc-seam" d="M75 138v8M100 138v8M125 138v8" data-part="bed"></path><path class="pc-o pc-mat pc-mat-pla" d="M84 136V125h11V129H116V136z" data-part="bed" data-testid="print-in-progress" data-output="parts"></path><path class="pc-layer" d="M87 131h26" data-part="bed"></path><rect class="pc-o pc-alu" x="46" y="88" width="108" height="8" rx="4" data-part="gantry"></rect><path class="pc-filament" d="M176 85C178 104 140 60 112 74" data-part="spool-holder"></path><path class="pc-thin" d="M136 28q16 4 13 18" data-part="controller"></path><rect class="pc-o pc-shell" x="62" y="6" width="76" height="40" rx="12" data-part="controller"></rect><g class="pc-carriage"><rect class="pc-o pc-pla" x="82" y="70" width="36" height="32" rx="8" data-part="extruder"></rect><circle class="pc-o pc-shell" cx="100" cy="86" r="9" data-part="extruder"></circle><path class="pc-thin" d="M100 79v14M93 86h14" data-part="extruder"></path><rect class="pc-o pc-alu" x="92" y="102" width="16" height="6" rx="1.5" data-part="hotend"></rect><path class="pc-o pc-brass" d="M95 108h10l-3 7h-4z" data-part="hotend"></path></g><g data-testid="lcd" data-face="worried"><rect class="pc-o pc-screen" x="70" y="13" width="60" height="26" rx="6"></rect><svg x="70" y="13" width="60" height="26" viewBox="0 0 60 26"><title>worried face</title><path class="pc-pixel" d="M49.8 2h3.9v3.9h-3.9zM14.6 6.4h3.9v3.9h-3.9zM19 6.4h3.9v3.9h-3.9zM36.6 6.4h3.9v3.9h-3.9zM41 6.4h3.9v3.9h-3.9zM49.8 6.4h3.9v3.9h-3.9zM14.6 10.8h3.9v3.9h-3.9zM19 10.8h3.9v3.9h-3.9zM36.6 10.8h3.9v3.9h-3.9zM41 10.8h3.9v3.9h-3.9zM14.6 19.6h3.9v3.9h-3.9zM23.4 19.6h3.9v3.9h-3.9zM32.2 19.6h3.9v3.9h-3.9zM41 19.6h3.9v3.9h-3.9z"></path></svg><path class="pc-glare" d="M116 17l6 0 -8 18 -6 0z"></path></g></g></g></g><g data-testid="progress-bar" data-purging="false"><rect class="ph-progress-track" x="6" y="170" width="148" height="5" rx="2.5"></rect><rect class="ph-progress-fill" x="6" y="170" width="74" height="5" rx="2.5"></rect></g><g data-testid="risk-meter" data-risk="0.85"><rect class="ph-risk-track" x="6" y="178" width="148" height="2"></rect><rect class="ph-risk-fill" x="6" y="178" width="125.8" height="2"></rect></g><g data-testid="perfect-meter" data-perfect="0.60"><rect class="ph-perfect-fill" x="6" y="181" width="88.8" height="2"></rect></g><g data-testid="overclock-slot-1" data-overclock="active" transform="translate(20, 22)"><circle class="ph-oc-track" r="9"></circle><circle class="ph-oc-fill ph-oc-fill--active" r="9" stroke-dasharray="28.274333882308138 56.548667764616276" transform="rotate(-90)"></circle><path class="ph-oc-bolt" d="M1 -6 -3 1h3l-1 5 4 -7h-3z"></path></g><g data-testid="count-badge"><circle class="ph-badge-disc" cx="138" cy="22" r="13"></circle><text class="ph-badge-text" x="138" y="22" text-anchor="middle" dominant-baseline="central">×7</text></g><text data-testid="label-slot-1" class="ph-label" x="80" y="201" text-anchor="middle">Bracket · PLA</text></g></g><g data-testid="mint" data-press-levels="1" data-plates="3" transform="translate(0, 208)"><title>1 press level(s) · 3 plate(s)</title><rect class="ph-bill" x="67" y="8" width="26" height="15" rx="2" style="animation-delay: 0s;"><title>bill-printer-1</title></rect></g></svg>"
`;

exports[`machine-tier visuals (spec §5A) > snapshots each tier so an art change is a reviewed diff > machine-tier-2 1`] = `
"<svg class="printhead-workshop" role="img" aria-label="PRINTHEAD workshop — Studio" data-visual-version="10" data-phase="studio" data-slot-capacity="1" data-layout="rack" data-backdrop="workshop" data-self-assembling="true" viewBox="0 0 160 252" preserveAspectRatio="xMidYMid meet"><title>PRINTHEAD — Studio</title><style>
.printhead-workshop {
  --ph-ink: #d7dee6;
  --ph-dim: #7b8794;
  --ph-bay: #10151b;
  --ph-bay-edge: #263141;
  --ph-accent: #4cc2ff;
  --ph-gold: #e8c469;
    --ph-warn: #ffb454;
  --ph-hot: #ff8a3d;
  --ph-sweep: 3.4s;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  display: block;
  width: 100%;
  height: auto;
}

.ph-bay { fill: var(--ph-bay); stroke: var(--ph-bay-edge); stroke-width: 1.5; }
.ph-bay--empty { fill: none; stroke-dasharray: 5 5; opacity: 0.45; }
.ph-bay--floor { fill: transparent; stroke: none !important; }
.ph-floor-shadow { fill: rgba(0, 0, 0, 0.3); }
.ph-floor-spot { cursor: grab; }
.ph-pile-part { fill: var(--char-pla, #E23673); stroke: #1C2330; stroke-width: 1.5; stroke-linejoin: round; }
.ph-pile-box { fill: #E2AA3A; stroke: #1C2330; stroke-width: 1.5; }
.ph-pile-item { transform-box: fill-box; animation: ph-pile-drop 420ms cubic-bezier(0.3, 1.6, 0.5, 1) both; }
@keyframes ph-pile-drop { from { opacity: 0; translate: 0 -24px; } to { opacity: 1; translate: 0 0; } }
.ph-wall { fill: rgba(255, 255, 255, 0.025); }
.ph-wall-skirting { stroke: rgba(255, 255, 255, 0.08); stroke-width: 2; }
.ph-wall-item { animation: ph-wall-in 700ms cubic-bezier(0.3, 1.5, 0.5, 1) both; transform-box: fill-box; transform-origin: top center; }
@keyframes ph-wall-in { from { opacity: 0; transform: translateY(-10px) rotate(-3deg); } }
.ph-wall-board { fill: #c9a26b; stroke: #1C2330; stroke-width: 2; }
.ph-wall-hole { fill: #8a6a3e; }
.ph-wall-tool { fill: none; stroke: #6C7884; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
.ph-wall-window { fill: #2a4d6e; stroke: #1C2330; stroke-width: 3; }
.ph-wall-frame { stroke: #1C2330; stroke-width: 3; }
.ph-wall-shelf { fill: #8a6a3e; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-spool-rim { fill: #DCE0DE; stroke: #1C2330; stroke-width: 2; }
.ph-wall-spool-hub { fill: #FAFAF7; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-clock { fill: #FAFAF7; stroke: #1C2330; stroke-width: 3; }
.ph-wall-hand { stroke: #1C2330; stroke-width: 2.5; stroke-linecap: round; }
.ph-wall-blueprint { fill: #2E5FC2; stroke: #1C2330; stroke-width: 2; }
.ph-wall-blueprint-ink { fill: none; stroke: #cfe0ff; stroke-width: 1.5; stroke-linecap: round; }
.ph-wall-plate { fill: #E2AA3A; stroke: #7a5208; stroke-width: 2; }
.ph-wall-neon { font: 400 30px/1 'Tilt Warp', 'Arial Rounded MT Bold', sans-serif; fill: #ff8ab3; letter-spacing: 4px; filter: drop-shadow(0 0 4px #ff3d84) drop-shadow(0 0 12px #ff3d84); animation: ph-neon 4s steps(1) infinite; }
@keyframes ph-neon { 0%, 92%, 96% { opacity: 1; } 93%, 97% { opacity: 0.35; } }
.ph-wall-wire { fill: none; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-bulb { fill: #ffd75a; filter: drop-shadow(0 0 4px #ffd75a); animation: ph-bulb 1.5s ease-in-out infinite alternate; }
@keyframes ph-bulb { to { opacity: 0.45; } }
.ph-slot--celebrate [data-testid="printer-figure"] &gt; g { transform-box: fill-box; transform-origin: 50% 100%; animation: ph-hop 520ms cubic-bezier(0.3, 1.6, 0.5, 1); }
@keyframes ph-hop { 0% { scale: 1 1; } 25% { scale: 1.08 0.9; } 55% { scale: 0.95 1.08; translate: 0 -6px; } 100% { scale: 1 1; translate: 0 0; } }
.ph-crew-more { font: 700 16px/1 'Martian Mono', ui-monospace, monospace; fill: var(--ph-accent); }
.ph-floor-spot.is-grabbed { cursor: grabbing; }
.ph-floor-spot.is-grabbed .ph-floor-shadow { fill: rgba(0, 0, 0, 0.18); }

.ph-label { fill: var(--ph-ink); font-size: 11px; }
.ph-label--dim { fill: var(--ph-dim); font-style: italic; }
.ph-badge-disc { fill: var(--ph-accent); }
.ph-badge-text { fill: #05090d; font-size: 12px; font-weight: 700; }

.ph-progress-track { fill: var(--ph-bay-edge); }
.ph-progress-fill { fill: var(--ph-accent); }
.ph-progress-fill--purge { fill: var(--ph-dim); }
.ph-risk-track { fill: var(--ph-bay-edge); }
.ph-risk-fill { fill: var(--ph-warn); }
.ph-perfect-fill { fill: var(--ph-gold); }

/* --- overclock (tap a printer) ----------------------------------------- */
.ph-oc-track { fill: none; stroke: var(--ph-bay-edge); stroke-width: 3; }
.ph-oc-fill { fill: none; stroke-width: 3; stroke-linecap: round; transition: stroke-dasharray 0.2s linear; }
.ph-oc-fill--ready { stroke: var(--ph-accent); }
.ph-oc-fill--active { stroke: var(--ph-hot); }
.ph-oc-fill--cooling { stroke: var(--ph-dim); }
.ph-oc-bolt { fill: var(--ph-ink); }
.ph-slot--pressable { cursor: pointer; }
.ph-slot--pressable:hover .ph-bay { stroke: var(--ph-accent); }
.ph-slot:focus-visible { outline: none; }
.ph-slot:focus-visible .ph-bay { stroke: var(--ph-accent); stroke-width: 3; }
[data-overclocked="true"] .ph-bay { stroke: var(--ph-hot); stroke-width: 2.5; }

/* --- print rota (spec §5B) ---------------------------------------------- */
.ph-queue-pip { fill: var(--ph-bay-edge); }
.ph-queue-pip--current { fill: var(--ph-accent); }

/* --- frame tiers (spec §5A) --------------------------------------------- */
.printer--frame-acrylic   { --ph-frame: #9fd9ff; --ph-frame-fill: rgba(159, 217, 255, 0.10); }
.printer--frame-aluminium { --ph-frame: #c9d3dd; --ph-frame-fill: rgba(201, 211, 221, 0.16); }
.printer--frame-steel     { --ph-frame: #8b98a8; --ph-frame-fill: rgba(139, 152, 168, 0.28); }

.ph-frame { fill: var(--ph-frame-fill); stroke: var(--ph-frame); }
.ph-strut { fill: var(--ph-frame); }
.ph-base { fill: #1b232d; stroke: var(--ph-frame); stroke-width: 1; }
.ph-enclosure { fill: rgba(159, 217, 255, 0.06); stroke: var(--ph-frame); stroke-dasharray: 3 3; }

/* --- bed tiers ----------------------------------------------------------- */
.ph-bed { fill: #38424f; }
.printer--bed-tape .ph-bed { fill: #4a5462; }
.printer--bed-heated .ph-bed { fill: #6b3a2c; }
.printer--bed-auto-level .ph-bed { fill: #2f4a44; }
.ph-bed-probe { fill: var(--ph-accent); }
.ph-bed-heat { fill: var(--ph-hot); opacity: 0.35; }

/* --- nozzle tiers -------------------------------------------------------- */
.ph-carriage-body { fill: #2b3542; stroke: var(--ph-frame); stroke-width: 1; }
.ph-nozzle { fill: #b98b3f; }
.printer--nozzle-hardened .ph-nozzle { fill: #6f7883; }
.printer--nozzle-glowing .ph-nozzle { fill: #ffd08a; }
.ph-nozzle-glow { fill: var(--ph-hot); opacity: 0; }
.printer--nozzle-glowing .ph-nozzle-glow { opacity: 0.3; }
.printer--running .ph-nozzle-glow { opacity: 0.55; }

.ph-spool-rim { fill: none; stroke: var(--ph-accent); stroke-width: 3; }
.ph-spool-hub { fill: var(--ph-dim); }
.ph-filament { fill: none; stroke: var(--ph-accent); stroke-width: 1.2; opacity: 0.7; }
.ph-controller { fill: #1b232d; stroke: var(--ph-frame); stroke-width: 1; }
.ph-controller-screen { fill: var(--ph-accent); opacity: 0.55; }
.ph-print { fill: var(--ph-accent); opacity: 0.85; }
/* A Product is not a Part: the studio bay reads gold (spec §5D). */
.ph-print--product { fill: var(--ph-gold); opacity: 0.95; }

/* The mint (spec §5E): one bill per installed press level, gently breathing. */
.ph-bill {
  fill: var(--ph-gold);
  opacity: 0.8;
  animation: ph-mint 1.8s ease-in-out infinite;
}
@keyframes ph-mint {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.95; }
}
@media (prefers-reduced-motion: reduce) {
  .ph-bill { animation: none; opacity: 0.8; }
}

/* --- the printed city (spec §5E) ----------------------------------------- */
.ph-backdrop-tower { fill: var(--ph-bay-edge); opacity: 0.5; }

/* --- the Universal Fabricator (spec §6 phase 6) --------------------------- */
.ph-fabricator-bed { fill: #1b232d; stroke: var(--ph-dim); stroke-width: 1; }
.ph-fabricator-band { fill: var(--ph-accent); opacity: 0.9; }
.ph-fabricator-band--pending { fill: none; stroke: var(--ph-bay-edge); stroke-width: 1; }
.ph-fabricator-band--printing {
  fill: var(--ph-hot);
  animation: ph-pulse 1.2s ease-in-out infinite;
}
.ph-fabricator--complete .ph-fabricator-band { fill: var(--ph-gold); }

/* --- the ending (spec §6 phase 6) ---------------------------------------- */
.printhead-ending {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  display: block;
  width: 100%;
  height: auto;
  background: #05090d;
}
.ph-ending-title { fill: #e8c469; font-size: 48px; text-anchor: middle; }
.ph-ending-line { fill: #d7dee6; font-size: 11px; text-anchor: middle; }
.ph-museum-case { fill: rgba(159, 217, 255, 0.05); stroke: #7b8794; stroke-dasharray: 4 3; }

/* --- the idle print-head animation --------------------------------------- */
@keyframes ph-sweep {
  from { transform: translateX(0); }
  to   { transform: translateX(var(--ph-travel, 70px)); }
}
@keyframes ph-spin { to { transform: rotate(360deg); } }
@keyframes ph-pulse {
  0%, 100% { opacity: 0.25; }
  50%      { opacity: 0.7; }
}

.ph-carriage {
  animation: ph-sweep var(--ph-sweep) ease-in-out infinite alternate;
  animation-delay: calc(var(--ph-offset, 0) * var(--ph-sweep) * -1);
}
.printer--idle .ph-carriage { animation-duration: calc(var(--ph-sweep) * 2.5); }
.ph-spool {
  transform-box: fill-box;
  transform-origin: center;
  animation: ph-spin calc(var(--ph-sweep) * 3) linear infinite;
  animation-delay: calc(var(--ph-offset, 0) * var(--ph-sweep) * -3);
  animation-play-state: paused;
}
.printer--running .ph-spool { animation-play-state: running; }
.printer--running .ph-nozzle-glow { animation: ph-pulse var(--ph-sweep) ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .ph-carriage, .ph-spool, .ph-nozzle-glow { animation: none; }
}


/* ==== Characters ========================================================= */
.pc-char { display: block; overflow: visible; }
.pc-o { stroke: var(--char-outline, #1C2330); stroke-width: var(--stroke-char, 3px); stroke-linejoin: round; stroke-linecap: round; }
.pc-none { fill: none; }
.pc-ink { fill: var(--char-outline, #1C2330); }
.pc-shell { fill: var(--char-shell, #FAFAF7); }
.pc-shade { fill: var(--char-shade, #DCE0DE); }
.pc-pla { fill: var(--char-pla, #E23673); }
.pc-acrylic { fill: var(--char-acrylic, #BEE5F4); }
.pc-alu { fill: var(--char-alu, #C7CFD5); }
.pc-steel { fill: var(--char-steel, #6C7884); }
.pc-brass { fill: var(--char-brass, #E2AA3A); }
.pc-tape { fill: var(--char-tape, #58A8E6); }
.pc-heat { fill: var(--char-heat, #EF6236); }
.pc-gold { fill: var(--char-brass, #E2AA3A); }
.pc-money { fill: var(--char-money, #4FA86E); }
.pc-carbon { fill: var(--char-carbon, #30353D); }
.pc-carbon-back { fill: var(--char-carbon, #30353D); opacity: 0.45; }
.pc-masking { fill: #efe1b0; }
.pc-petg-c { fill: #1fa595; }
.pc-resin-c { fill: var(--char-amber, #F5A23A); }
.pc-blueprint-c { fill: #4c86e8; }
.pc-plate-in { fill: #2a323b; }
.pc-mat-pla { fill: #E23673; }
.pc-mat-petg { fill: #1FA595; }
.pc-mat-resin { fill: #F5A23A; }
.pc-mat-metal { fill: #9AA6B2; }
.pc-mat-composite { fill: #4C5563; }
.pc-print-product { fill: var(--ph-gold, #e2b65a); }
.pc-resin-print { fill: #f3c98a; }
.pc-screen { fill: var(--char-screen, #142A2C); }
.pc-pixel { fill: var(--char-pixel, #7DF0C3); }
.pc-glare { fill: #ffffff; opacity: 0.08; }
.pc-shadow { fill: var(--char-shadow, rgba(28, 35, 48, 0.14)); }
.pc-amber { fill: var(--char-amber, #F5A23A); fill-opacity: 0.72; }
.pc-glass { fill: var(--char-glass, #D6F1F6); fill-opacity: 0.4; }
.pc-hot { fill: #ffd27a; }
.pc-glow { fill: #ff9a3c; opacity: 0.45; }
.pc-thin { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 2px; stroke-linecap: round; }
.pc-seam { fill: none; stroke: #ffffff; stroke-opacity: 0.55; stroke-width: 1.5px; }
.pc-layer { fill: none; stroke: var(--char-pla-deep, #A8204F); stroke-width: 1.5px; stroke-linecap: round; }
.pc-layer-petg { fill: none; stroke: #0b6a5f; stroke-width: 1.5px; stroke-linecap: round; }
.pc-layer-resin { fill: none; stroke: #c48a3a; stroke-width: 1.2px; }
.pc-winding { stroke: var(--char-pla-deep, #A8204F); stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-winding-petg { stroke: #0b6a5f; stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-winding-gold { stroke: #9a6c14; stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-filament { fill: none; stroke: var(--char-pla, #E23673); stroke-width: 2.5px; stroke-linecap: round; }
.pc-filament-petg { fill: none; stroke: #1fa595; stroke-width: 2.5px; stroke-linecap: round; }
.pc-filament-gold { fill: none; stroke: var(--char-brass, #E2AA3A); stroke-width: 2.5px; stroke-linecap: round; }
.pc-groove { fill: none; stroke: #8f9aa3; stroke-width: 2px; }
.pc-shimmer { fill: none; stroke: var(--char-heat, #EF6236); stroke-width: 2.5px; stroke-linecap: round; opacity: 0.8; }
.pc-speckle { fill: none; stroke: #7d5a14; stroke-width: 2.5px; stroke-linecap: round; opacity: 0.6; }
.pc-reflect { fill: none; stroke: #ffffff; stroke-width: 3px; stroke-linecap: round; opacity: 0.55; }
.pc-liquid { fill: none; stroke: var(--char-amber, #F5A23A); stroke-width: 3px; stroke-linecap: round; }
.pc-rivet { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 4px; stroke-linecap: round; opacity: 0.5; }
.pc-arm { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 2.5px; stroke-linecap: round; }
.pc-halo { fill: none; stroke: var(--char-brass, #E2AA3A); stroke-width: 4px; opacity: 0.9; }

/* idle life: blink, sweep, spool, shimmer. Phase offset desyncs bays. */
.pc-eyes-blink { opacity: 0; }
.pc-char .pc-eyes-open { animation: pc-blink-open 5.2s steps(1) infinite; animation-delay: calc(var(--pc-offset, 0) * -5.2s); }
.pc-char .pc-eyes-blink { animation: pc-blink-shut 5.2s steps(1) infinite; animation-delay: calc(var(--pc-offset, 0) * -5.2s); }
@keyframes pc-blink-open { 0%, 95% { opacity: 1; } 96%, 99% { opacity: 0; } }
@keyframes pc-blink-shut { 0%, 95% { opacity: 0; } 96%, 99% { opacity: 1; } }
.is-printing .pc-carriage { animation: pc-sweep var(--ph-sweep, 3.4s) ease-in-out infinite alternate; animation-delay: calc(var(--pc-offset, 0) * -3.4s); }
@keyframes pc-sweep { from { transform: translateX(-16px); } to { transform: translateX(16px); } }
.is-printing .pc-spool { transform-box: fill-box; transform-origin: center; animation: pc-spin 10s linear infinite; }
@keyframes pc-spin { to { transform: rotate(360deg); } }
.is-printing .pc-shimmer { animation: pc-shimmer 1.6s ease-in-out infinite; }
@keyframes pc-shimmer { 50% { opacity: 0.25; transform: translateY(-3px); } }
.is-printing .pc-bill-fly { animation: pc-float 2.4s ease-in-out infinite; }
@keyframes pc-float { 50% { transform: translateY(-5px); } }
@media (prefers-reduced-motion: reduce) {
  .pc-char *, .pc-char { animation: none !important; }
  .pc-eyes-blink { opacity: 0; }
}


/* overclocked: the toolhead races and the bay glows */
.is-overclocked .pc-carriage { animation-duration: 0.9s; }
.is-overclocked .pc-glare { opacity: 0.2; }

</style><g transform="translate(0, 0)"><g data-testid="slot-slot-2" data-occupied="true" data-slot-index="0" data-output="parts" data-overclocked="false" class="ph-slot  "><rect data-testid="bay-slot-2" class="ph-bay" x="0" y="0" width="160" height="208" rx="8"></rect><g data-testid="printer-figure" data-machine-tier="2" data-frame="aluminium" data-nozzle="hardened" data-bed="heated" data-output="parts" class="printer printer--tier-2 printer--frame-aluminium printer--running" style="--ph-offset: 0.25;"><title>Aluminium frame · hardened nozzle · heated bed</title><g transform="translate(-4, 4) scale(0.84)"><g data-testid="character" data-kind="mk2" data-face="focus" class="pc-char pc-mk2 is-printing" style="--pc-offset: 0.25;"><ellipse class="pc-shadow" cx="100" cy="188" rx="78" ry="6"></ellipse><rect class="pc-o pc-ink" x="34" y="174" width="20" height="9" rx="3"></rect><rect class="pc-o pc-ink" x="146" y="174" width="20" height="9" rx="3"></rect><path class="pc-o pc-none" d="M38 46h-14"></path><circle class="pc-o pc-petg-c" cx="22" cy="68" r="18"></circle><circle class="pc-winding-petg" cx="22" cy="68" r="13" fill="none"></circle><circle class="pc-o pc-shell" cx="22" cy="68" r="6.84"></circle><circle class="pc-ink" cx="22" cy="68" r="2.16"></circle><rect class="pc-o pc-alu" x="38" y="44" width="14" height="108" rx="2"></rect><rect class="pc-o pc-alu" x="148" y="44" width="14" height="108" rx="2"></rect><path class="pc-groove" d="M45 50v96M155 50v96"></path><rect class="pc-o pc-alu" x="34" y="38" width="132" height="14" rx="3"></rect><rect class="pc-o pc-shell" x="24" y="146" width="152" height="32" rx="10"></rect><rect class="pc-o pc-shade" x="130" y="154" width="34" height="16" rx="4"></rect><path class="pc-thin" d="M38 158h18M38 166h18"></path><rect class="pc-o pc-heat" x="44" y="132" width="112" height="12" rx="3"></rect><path class="pc-shimmer" d="M58 126q3 -4 0 -8t0 -8M142 126q3 -4 0 -8t0 -8"></path><path class="pc-o pc-mat pc-mat-petg" d="M80 132V131H81V128H83V131H86H87V128H89V131H92H93V128H95V131H98H99V128H101V131H104H105V128H107V131H110H111V128H113V131H116H117V128H119V131H120V132z" data-testid="print-in-progress" data-output="parts"></path><rect class="pc-o pc-alu" x="44" y="86" width="112" height="10" rx="4"></rect><path class="pc-filament-petg" d="M22 86C24 100 60 58 90 70"></path><rect class="pc-o pc-shell" x="58" y="4" width="84" height="42" rx="12"></rect><path class="pc-o pc-alu" d="M58 18v-2a12 12 0 0 1 12 -12h60a12 12 0 0 1 12 12v2z"></path><g class="pc-carriage"><rect class="pc-o pc-pla" x="78" y="66" width="44" height="36" rx="9"></rect><circle class="pc-o pc-shell" cx="92" cy="84" r="8"></circle><circle class="pc-o pc-shell" cx="110" cy="84" r="8"></circle><path class="pc-thin" d="M92 78v12M86 84h12M110 78v12M104 84h12"></path><rect class="pc-o pc-alu" x="92" y="102" width="16" height="7" rx="1.5"></rect><path class="pc-o pc-steel" d="M95 109h10l-3 7h-4z"></path></g><g data-testid="lcd" data-face="focus"><rect class="pc-o pc-screen" x="66" y="17" width="68" height="24" rx="6"></rect><svg x="66" y="17" width="68" height="24" viewBox="0 0 60 26"><title>focus face</title><path class="pc-pixel" d="M10.2 6.4h3.9v3.9h-3.9zM14.6 6.4h3.9v3.9h-3.9zM19 6.4h3.9v3.9h-3.9zM36.6 6.4h3.9v3.9h-3.9zM41 6.4h3.9v3.9h-3.9zM45.4 6.4h3.9v3.9h-3.9zM14.6 10.8h3.9v3.9h-3.9zM19 10.8h3.9v3.9h-3.9zM36.6 10.8h3.9v3.9h-3.9zM41 10.8h3.9v3.9h-3.9zM14.6 15.2h3.9v3.9h-3.9zM19 15.2h3.9v3.9h-3.9zM36.6 15.2h3.9v3.9h-3.9zM41 15.2h3.9v3.9h-3.9z"></path></svg><path class="pc-glare" d="M120 21l6 0 -8 16 -6 0z"></path></g></g></g></g><g data-testid="progress-bar" data-purging="false"><rect class="ph-progress-track" x="6" y="170" width="148" height="5" rx="2.5"></rect><rect class="ph-progress-fill" x="6" y="170" width="18.5" height="5" rx="2.5"></rect></g><g data-testid="risk-meter" data-risk="0.40"><rect class="ph-risk-track" x="6" y="178" width="148" height="2"></rect><rect class="ph-risk-fill" x="6" y="178" width="59.2" height="2"></rect></g><g data-testid="perfect-meter" data-perfect="0.60"><rect class="ph-perfect-fill" x="6" y="181" width="88.8" height="2"></rect></g><g data-testid="overclock-slot-2" data-overclock="cooling" transform="translate(20, 22)"><circle class="ph-oc-track" r="9"></circle><circle class="ph-oc-fill ph-oc-fill--cooling" r="9" stroke-dasharray="56.548667764616276 56.548667764616276" transform="rotate(-90)"></circle><path class="ph-oc-bolt" d="M1 -6 -3 1h3l-1 5 4 -7h-3z"></path></g><g data-testid="count-badge"><circle class="ph-badge-disc" cx="138" cy="22" r="13"></circle><text class="ph-badge-text" x="138" y="22" text-anchor="middle" dominant-baseline="central">×3</text></g><text data-testid="label-slot-2" class="ph-label" x="80" y="201" text-anchor="middle">Gear set · PETG</text></g></g><g data-testid="mint" data-press-levels="1" data-plates="3" transform="translate(0, 208)"><title>1 press level(s) · 3 plate(s)</title><rect class="ph-bill" x="67" y="8" width="26" height="15" rx="2" style="animation-delay: 0s;"><title>bill-printer-1</title></rect></g></svg>"
`;

exports[`machine-tier visuals (spec §5A) > snapshots each tier so an art change is a reviewed diff > machine-tier-3 1`] = `
"<svg class="printhead-workshop" role="img" aria-label="PRINTHEAD workshop — Studio" data-visual-version="10" data-phase="studio" data-slot-capacity="1" data-layout="rack" data-backdrop="workshop" data-self-assembling="true" viewBox="0 0 160 252" preserveAspectRatio="xMidYMid meet"><title>PRINTHEAD — Studio</title><style>
.printhead-workshop {
  --ph-ink: #d7dee6;
  --ph-dim: #7b8794;
  --ph-bay: #10151b;
  --ph-bay-edge: #263141;
  --ph-accent: #4cc2ff;
  --ph-gold: #e8c469;
    --ph-warn: #ffb454;
  --ph-hot: #ff8a3d;
  --ph-sweep: 3.4s;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  display: block;
  width: 100%;
  height: auto;
}

.ph-bay { fill: var(--ph-bay); stroke: var(--ph-bay-edge); stroke-width: 1.5; }
.ph-bay--empty { fill: none; stroke-dasharray: 5 5; opacity: 0.45; }
.ph-bay--floor { fill: transparent; stroke: none !important; }
.ph-floor-shadow { fill: rgba(0, 0, 0, 0.3); }
.ph-floor-spot { cursor: grab; }
.ph-pile-part { fill: var(--char-pla, #E23673); stroke: #1C2330; stroke-width: 1.5; stroke-linejoin: round; }
.ph-pile-box { fill: #E2AA3A; stroke: #1C2330; stroke-width: 1.5; }
.ph-pile-item { transform-box: fill-box; animation: ph-pile-drop 420ms cubic-bezier(0.3, 1.6, 0.5, 1) both; }
@keyframes ph-pile-drop { from { opacity: 0; translate: 0 -24px; } to { opacity: 1; translate: 0 0; } }
.ph-wall { fill: rgba(255, 255, 255, 0.025); }
.ph-wall-skirting { stroke: rgba(255, 255, 255, 0.08); stroke-width: 2; }
.ph-wall-item { animation: ph-wall-in 700ms cubic-bezier(0.3, 1.5, 0.5, 1) both; transform-box: fill-box; transform-origin: top center; }
@keyframes ph-wall-in { from { opacity: 0; transform: translateY(-10px) rotate(-3deg); } }
.ph-wall-board { fill: #c9a26b; stroke: #1C2330; stroke-width: 2; }
.ph-wall-hole { fill: #8a6a3e; }
.ph-wall-tool { fill: none; stroke: #6C7884; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
.ph-wall-window { fill: #2a4d6e; stroke: #1C2330; stroke-width: 3; }
.ph-wall-frame { stroke: #1C2330; stroke-width: 3; }
.ph-wall-shelf { fill: #8a6a3e; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-spool-rim { fill: #DCE0DE; stroke: #1C2330; stroke-width: 2; }
.ph-wall-spool-hub { fill: #FAFAF7; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-clock { fill: #FAFAF7; stroke: #1C2330; stroke-width: 3; }
.ph-wall-hand { stroke: #1C2330; stroke-width: 2.5; stroke-linecap: round; }
.ph-wall-blueprint { fill: #2E5FC2; stroke: #1C2330; stroke-width: 2; }
.ph-wall-blueprint-ink { fill: none; stroke: #cfe0ff; stroke-width: 1.5; stroke-linecap: round; }
.ph-wall-plate { fill: #E2AA3A; stroke: #7a5208; stroke-width: 2; }
.ph-wall-neon { font: 400 30px/1 'Tilt Warp', 'Arial Rounded MT Bold', sans-serif; fill: #ff8ab3; letter-spacing: 4px; filter: drop-shadow(0 0 4px #ff3d84) drop-shadow(0 0 12px #ff3d84); animation: ph-neon 4s steps(1) infinite; }
@keyframes ph-neon { 0%, 92%, 96% { opacity: 1; } 93%, 97% { opacity: 0.35; } }
.ph-wall-wire { fill: none; stroke: #1C2330; stroke-width: 1.5; }
.ph-wall-bulb { fill: #ffd75a; filter: drop-shadow(0 0 4px #ffd75a); animation: ph-bulb 1.5s ease-in-out infinite alternate; }
@keyframes ph-bulb { to { opacity: 0.45; } }
.ph-slot--celebrate [data-testid="printer-figure"] &gt; g { transform-box: fill-box; transform-origin: 50% 100%; animation: ph-hop 520ms cubic-bezier(0.3, 1.6, 0.5, 1); }
@keyframes ph-hop { 0% { scale: 1 1; } 25% { scale: 1.08 0.9; } 55% { scale: 0.95 1.08; translate: 0 -6px; } 100% { scale: 1 1; translate: 0 0; } }
.ph-crew-more { font: 700 16px/1 'Martian Mono', ui-monospace, monospace; fill: var(--ph-accent); }
.ph-floor-spot.is-grabbed { cursor: grabbing; }
.ph-floor-spot.is-grabbed .ph-floor-shadow { fill: rgba(0, 0, 0, 0.18); }

.ph-label { fill: var(--ph-ink); font-size: 11px; }
.ph-label--dim { fill: var(--ph-dim); font-style: italic; }
.ph-badge-disc { fill: var(--ph-accent); }
.ph-badge-text { fill: #05090d; font-size: 12px; font-weight: 700; }

.ph-progress-track { fill: var(--ph-bay-edge); }
.ph-progress-fill { fill: var(--ph-accent); }
.ph-progress-fill--purge { fill: var(--ph-dim); }
.ph-risk-track { fill: var(--ph-bay-edge); }
.ph-risk-fill { fill: var(--ph-warn); }
.ph-perfect-fill { fill: var(--ph-gold); }

/* --- overclock (tap a printer) ----------------------------------------- */
.ph-oc-track { fill: none; stroke: var(--ph-bay-edge); stroke-width: 3; }
.ph-oc-fill { fill: none; stroke-width: 3; stroke-linecap: round; transition: stroke-dasharray 0.2s linear; }
.ph-oc-fill--ready { stroke: var(--ph-accent); }
.ph-oc-fill--active { stroke: var(--ph-hot); }
.ph-oc-fill--cooling { stroke: var(--ph-dim); }
.ph-oc-bolt { fill: var(--ph-ink); }
.ph-slot--pressable { cursor: pointer; }
.ph-slot--pressable:hover .ph-bay { stroke: var(--ph-accent); }
.ph-slot:focus-visible { outline: none; }
.ph-slot:focus-visible .ph-bay { stroke: var(--ph-accent); stroke-width: 3; }
[data-overclocked="true"] .ph-bay { stroke: var(--ph-hot); stroke-width: 2.5; }

/* --- print rota (spec §5B) ---------------------------------------------- */
.ph-queue-pip { fill: var(--ph-bay-edge); }
.ph-queue-pip--current { fill: var(--ph-accent); }

/* --- frame tiers (spec §5A) --------------------------------------------- */
.printer--frame-acrylic   { --ph-frame: #9fd9ff; --ph-frame-fill: rgba(159, 217, 255, 0.10); }
.printer--frame-aluminium { --ph-frame: #c9d3dd; --ph-frame-fill: rgba(201, 211, 221, 0.16); }
.printer--frame-steel     { --ph-frame: #8b98a8; --ph-frame-fill: rgba(139, 152, 168, 0.28); }

.ph-frame { fill: var(--ph-frame-fill); stroke: var(--ph-frame); }
.ph-strut { fill: var(--ph-frame); }
.ph-base { fill: #1b232d; stroke: var(--ph-frame); stroke-width: 1; }
.ph-enclosure { fill: rgba(159, 217, 255, 0.06); stroke: var(--ph-frame); stroke-dasharray: 3 3; }

/* --- bed tiers ----------------------------------------------------------- */
.ph-bed { fill: #38424f; }
.printer--bed-tape .ph-bed { fill: #4a5462; }
.printer--bed-heated .ph-bed { fill: #6b3a2c; }
.printer--bed-auto-level .ph-bed { fill: #2f4a44; }
.ph-bed-probe { fill: var(--ph-accent); }
.ph-bed-heat { fill: var(--ph-hot); opacity: 0.35; }

/* --- nozzle tiers -------------------------------------------------------- */
.ph-carriage-body { fill: #2b3542; stroke: var(--ph-frame); stroke-width: 1; }
.ph-nozzle { fill: #b98b3f; }
.printer--nozzle-hardened .ph-nozzle { fill: #6f7883; }
.printer--nozzle-glowing .ph-nozzle { fill: #ffd08a; }
.ph-nozzle-glow { fill: var(--ph-hot); opacity: 0; }
.printer--nozzle-glowing .ph-nozzle-glow { opacity: 0.3; }
.printer--running .ph-nozzle-glow { opacity: 0.55; }

.ph-spool-rim { fill: none; stroke: var(--ph-accent); stroke-width: 3; }
.ph-spool-hub { fill: var(--ph-dim); }
.ph-filament { fill: none; stroke: var(--ph-accent); stroke-width: 1.2; opacity: 0.7; }
.ph-controller { fill: #1b232d; stroke: var(--ph-frame); stroke-width: 1; }
.ph-controller-screen { fill: var(--ph-accent); opacity: 0.55; }
.ph-print { fill: var(--ph-accent); opacity: 0.85; }
/* A Product is not a Part: the studio bay reads gold (spec §5D). */
.ph-print--product { fill: var(--ph-gold); opacity: 0.95; }

/* The mint (spec §5E): one bill per installed press level, gently breathing. */
.ph-bill {
  fill: var(--ph-gold);
  opacity: 0.8;
  animation: ph-mint 1.8s ease-in-out infinite;
}
@keyframes ph-mint {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.95; }
}
@media (prefers-reduced-motion: reduce) {
  .ph-bill { animation: none; opacity: 0.8; }
}

/* --- the printed city (spec §5E) ----------------------------------------- */
.ph-backdrop-tower { fill: var(--ph-bay-edge); opacity: 0.5; }

/* --- the Universal Fabricator (spec §6 phase 6) --------------------------- */
.ph-fabricator-bed { fill: #1b232d; stroke: var(--ph-dim); stroke-width: 1; }
.ph-fabricator-band { fill: var(--ph-accent); opacity: 0.9; }
.ph-fabricator-band--pending { fill: none; stroke: var(--ph-bay-edge); stroke-width: 1; }
.ph-fabricator-band--printing {
  fill: var(--ph-hot);
  animation: ph-pulse 1.2s ease-in-out infinite;
}
.ph-fabricator--complete .ph-fabricator-band { fill: var(--ph-gold); }

/* --- the ending (spec §6 phase 6) ---------------------------------------- */
.printhead-ending {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  display: block;
  width: 100%;
  height: auto;
  background: #05090d;
}
.ph-ending-title { fill: #e8c469; font-size: 48px; text-anchor: middle; }
.ph-ending-line { fill: #d7dee6; font-size: 11px; text-anchor: middle; }
.ph-museum-case { fill: rgba(159, 217, 255, 0.05); stroke: #7b8794; stroke-dasharray: 4 3; }

/* --- the idle print-head animation --------------------------------------- */
@keyframes ph-sweep {
  from { transform: translateX(0); }
  to   { transform: translateX(var(--ph-travel, 70px)); }
}
@keyframes ph-spin { to { transform: rotate(360deg); } }
@keyframes ph-pulse {
  0%, 100% { opacity: 0.25; }
  50%      { opacity: 0.7; }
}

.ph-carriage {
  animation: ph-sweep var(--ph-sweep) ease-in-out infinite alternate;
  animation-delay: calc(var(--ph-offset, 0) * var(--ph-sweep) * -1);
}
.printer--idle .ph-carriage { animation-duration: calc(var(--ph-sweep) * 2.5); }
.ph-spool {
  transform-box: fill-box;
  transform-origin: center;
  animation: ph-spin calc(var(--ph-sweep) * 3) linear infinite;
  animation-delay: calc(var(--ph-offset, 0) * var(--ph-sweep) * -3);
  animation-play-state: paused;
}
.printer--running .ph-spool { animation-play-state: running; }
.printer--running .ph-nozzle-glow { animation: ph-pulse var(--ph-sweep) ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .ph-carriage, .ph-spool, .ph-nozzle-glow { animation: none; }
}


/* ==== Characters ========================================================= */
.pc-char { display: block; overflow: visible; }
.pc-o { stroke: var(--char-outline, #1C2330); stroke-width: var(--stroke-char, 3px); stroke-linejoin: round; stroke-linecap: round; }
.pc-none { fill: none; }
.pc-ink { fill: var(--char-outline, #1C2330); }
.pc-shell { fill: var(--char-shell, #FAFAF7); }
.pc-shade { fill: var(--char-shade, #DCE0DE); }
.pc-pla { fill: var(--char-pla, #E23673); }
.pc-acrylic { fill: var(--char-acrylic, #BEE5F4); }
.pc-alu { fill: var(--char-alu, #C7CFD5); }
.pc-steel { fill: var(--char-steel, #6C7884); }
.pc-brass { fill: var(--char-brass, #E2AA3A); }
.pc-tape { fill: var(--char-tape, #58A8E6); }
.pc-heat { fill: var(--char-heat, #EF6236); }
.pc-gold { fill: var(--char-brass, #E2AA3A); }
.pc-money { fill: var(--char-money, #4FA86E); }
.pc-carbon { fill: var(--char-carbon, #30353D); }
.pc-carbon-back { fill: var(--char-carbon, #30353D); opacity: 0.45; }
.pc-masking { fill: #efe1b0; }
.pc-petg-c { fill: #1fa595; }
.pc-resin-c { fill: var(--char-amber, #F5A23A); }
.pc-blueprint-c { fill: #4c86e8; }
.pc-plate-in { fill: #2a323b; }
.pc-mat-pla { fill: #E23673; }
.pc-mat-petg { fill: #1FA595; }
.pc-mat-resin { fill: #F5A23A; }
.pc-mat-metal { fill: #9AA6B2; }
.pc-mat-composite { fill: #4C5563; }
.pc-print-product { fill: var(--ph-gold, #e2b65a); }
.pc-resin-print { fill: #f3c98a; }
.pc-screen { fill: var(--char-screen, #142A2C); }
.pc-pixel { fill: var(--char-pixel, #7DF0C3); }
.pc-glare { fill: #ffffff; opacity: 0.08; }
.pc-shadow { fill: var(--char-shadow, rgba(28, 35, 48, 0.14)); }
.pc-amber { fill: var(--char-amber, #F5A23A); fill-opacity: 0.72; }
.pc-glass { fill: var(--char-glass, #D6F1F6); fill-opacity: 0.4; }
.pc-hot { fill: #ffd27a; }
.pc-glow { fill: #ff9a3c; opacity: 0.45; }
.pc-thin { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 2px; stroke-linecap: round; }
.pc-seam { fill: none; stroke: #ffffff; stroke-opacity: 0.55; stroke-width: 1.5px; }
.pc-layer { fill: none; stroke: var(--char-pla-deep, #A8204F); stroke-width: 1.5px; stroke-linecap: round; }
.pc-layer-petg { fill: none; stroke: #0b6a5f; stroke-width: 1.5px; stroke-linecap: round; }
.pc-layer-resin { fill: none; stroke: #c48a3a; stroke-width: 1.2px; }
.pc-winding { stroke: var(--char-pla-deep, #A8204F); stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-winding-petg { stroke: #0b6a5f; stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-winding-gold { stroke: #9a6c14; stroke-width: 1.5px; stroke-dasharray: 4 3; }
.pc-filament { fill: none; stroke: var(--char-pla, #E23673); stroke-width: 2.5px; stroke-linecap: round; }
.pc-filament-petg { fill: none; stroke: #1fa595; stroke-width: 2.5px; stroke-linecap: round; }
.pc-filament-gold { fill: none; stroke: var(--char-brass, #E2AA3A); stroke-width: 2.5px; stroke-linecap: round; }
.pc-groove { fill: none; stroke: #8f9aa3; stroke-width: 2px; }
.pc-shimmer { fill: none; stroke: var(--char-heat, #EF6236); stroke-width: 2.5px; stroke-linecap: round; opacity: 0.8; }
.pc-speckle { fill: none; stroke: #7d5a14; stroke-width: 2.5px; stroke-linecap: round; opacity: 0.6; }
.pc-reflect { fill: none; stroke: #ffffff; stroke-width: 3px; stroke-linecap: round; opacity: 0.55; }
.pc-liquid { fill: none; stroke: var(--char-amber, #F5A23A); stroke-width: 3px; stroke-linecap: round; }
.pc-rivet { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 4px; stroke-linecap: round; opacity: 0.5; }
.pc-arm { fill: none; stroke: var(--char-outline, #1C2330); stroke-width: 2.5px; stroke-linecap: round; }
.pc-halo { fill: none; stroke: var(--char-brass, #E2AA3A); stroke-width: 4px; opacity: 0.9; }

/* idle life: blink, sweep, spool, shimmer. Phase offset desyncs bays. */
.pc-eyes-blink { opacity: 0; }
.pc-char .pc-eyes-open { animation: pc-blink-open 5.2s steps(1) infinite; animation-delay: calc(var(--pc-offset, 0) * -5.2s); }
.pc-char .pc-eyes-blink { animation: pc-blink-shut 5.2s steps(1) infinite; animation-delay: calc(var(--pc-offset, 0) * -5.2s); }
@keyframes pc-blink-open { 0%, 95% { opacity: 1; } 96%, 99% { opacity: 0; } }
@keyframes pc-blink-shut { 0%, 95% { opacity: 0; } 96%, 99% { opacity: 1; } }
.is-printing .pc-carriage { animation: pc-sweep var(--ph-sweep, 3.4s) ease-in-out infinite alternate; animation-delay: calc(var(--pc-offset, 0) * -3.4s); }
@keyframes pc-sweep { from { transform: translateX(-16px); } to { transform: translateX(16px); } }
.is-printing .pc-spool { transform-box: fill-box; transform-origin: center; animation: pc-spin 10s linear infinite; }
@keyframes pc-spin { to { transform: rotate(360deg); } }
.is-printing .pc-shimmer { animation: pc-shimmer 1.6s ease-in-out infinite; }
@keyframes pc-shimmer { 50% { opacity: 0.25; transform: translateY(-3px); } }
.is-printing .pc-bill-fly { animation: pc-float 2.4s ease-in-out infinite; }
@keyframes pc-float { 50% { transform: translateY(-5px); } }
@media (prefers-reduced-motion: reduce) {
  .pc-char *, .pc-char { animation: none !important; }
  .pc-eyes-blink { opacity: 0; }
}


/* overclocked: the toolhead races and the bay glows */
.is-overclocked .pc-carriage { animation-duration: 0.9s; }
.is-overclocked .pc-glare { opacity: 0.2; }

