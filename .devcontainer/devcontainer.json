// PRINTHEAD — .devcontainer/devcontainer.json
// Merged: PRINTHEAD toolchain + proven patterns from the Trak setup.
{
  "name": "printhead",
  "build": { "dockerfile": "Dockerfile" },

  // From Trak: dedicated "claude" user with automatic UID/GID mapping
  // (clean file ownership on bind mounts) and sudo for ad-hoc installs.
  "remoteUser": "claude",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "claude",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    // Official feature installs Claude Code (Node comes from the base image —
    // Trak's node feature is not needed here).
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "mounts": [
    // From Trak: ONE host directory holds Claude Code auth/config for ALL
    // projects — sign in once, reuse everywhere. Run once on the host:
    //   mkdir -p ~/.claude-personal
    "source=${localEnv:HOME}/.claude-personal,target=/home/claude/.claude,type=bind",
    // PRINTHEAD-specific: Playwright browser cache survives rebuilds.
    "source=printhead-pw-browsers,target=/home/claude/.cache/ms-playwright,type=volume"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/claude/.claude",
    // From Trak: deterministic Claude Code version per container build;
    // update by rebuilding the container instead of in-place auto-updates.
    "DISABLE_AUTOUPDATER": "1"
  },

  // Vite dev server + preview
  "forwardPorts": [5173, 4173],

  // Trak's safe.directory fix (bind mount + mapped UID => git "dubious
  // ownership" otherwise), then PRINTHEAD's guarded install steps.
  "postCreateCommand": "bash -lc \"git config --global --add safe.directory '*' && ([ -f package.json ] && pnpm install || true) && ([ -f package.json ] && pnpm exec playwright install chromium || true)\"",
  "waitFor": "postCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "biomejs.biome",
        "vitest.explorer",
        "ms-playwright.playwright"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": { "source.organizeImports.biome": "explicit" }
      }
    }
  }
}