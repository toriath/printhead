{
  "name": "printhead",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "content:check": "tsx scripts/check-content.ts",
    "literals:check": "tsx scripts/check-no-literals.ts",
    "pace:check": "tsx scripts/check-pace-scale.ts",
    "deps:check": "depcruise packages tools scripts --config .dependency-cruiser.cjs",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=3",
    "check": "pnpm run lint && pnpm run content:check && pnpm run literals:check && pnpm run pace:check && pnpm run deps:check && pnpm run typecheck && pnpm run test",
    "mutation": "pnpm --filter @printhead/core mutation",
    "balance:sim": "tsx tools/balance/src/cli.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "clean": "rm -rf packages/*/dist tools/*/dist e2e/dist .tsbuildinfo packages/*/*.tsbuildinfo tools/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@printhead/core": "workspace:*",
    "@playwright/test": "1.49.1",
    "@types/node": "22.20.1",
    "dependency-cruiser": "16.10.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
